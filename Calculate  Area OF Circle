package sagar;

class Circle {
    double radius;

    double calculateArea() {
        return 3.14 * radius * radius;
    }
}

public class Program10 {
    public static void main(String[] args) {
        Circle c = new Circle();

        c.radius = 7;

        System.out.println("Area of circle = " + c.calculateArea());
    }
}
