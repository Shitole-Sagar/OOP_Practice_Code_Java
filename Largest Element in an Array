package sagar;

public class Largest {
    public static void main(String[] args) {
        int[] numbers = {25, 10, 75, 40, 60};

        int largest = numbers[0];

        for (int i = 1; i < numbers.length; i++) {
            if (numbers[i] > largest) {
                largest = numbers[i];
            }
        }

        System.out.println("Largest element = " + largest);
    }
}
